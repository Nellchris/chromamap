{
  "version": 8,
  "name": "CartoAccessibility test style",
  "metadata": {
    "carto-a11y:purpose": "Fixture: distinguishable to normal vision, but parks and industrial collapse under protanopia."
  },
  "sources": {
    "demo": {
      "type": "vector",
      "url": "https://example.invalid/demo/tiles.json"
    }
  },
  "layers": [
    {
      "id": "water",
      "type": "fill",
      "source": "demo",
      "source-layer": "water",
      "paint": {
        "fill-color": "#aad3df"
      }
    },
    {
      "id": "parks",
      "type": "fill",
      "source": "demo",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "park"],
      "paint": {
        "fill-color": "#006a00"
      }
    },
    {
      "id": "industrial",
      "type": "fill",
      "source": "demo",
      "source-layer": "landuse",
      "filter": ["==", ["get", "class"], "industrial"],
      "paint": {
        "fill-color": "#ff0000"
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "demo",
      "source-layer": "building",
      "paint": {
        "fill-color": "#8b7355",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "construction",
      "type": "fill",
      "source": "demo",
      "source-layer": "landuse",
      "layout": {
        "visibility": "none"
      },
      "paint": {
        "fill-color": "#000000"
      }
    }
  ]
}
