{
  "version": 8,
  "name": "Hawaiʻi geological map — accessible",
  "metadata": {
    "carto-a11y:purpose": "The after picture. Same layers, same data, same labels as baseline.json; only the colours differ. The palette is spread evenly through lightness instead of relying on hue, which is the part of colour that dichromacy takes away.",
    "carto-a11y:generatedBy": "scripts/remediate-hawaii.ts",
    "carto-a11y:derivedFrom": "baseline.json"
  },
  "center": [
    -155.5,
    19.6
  ],
  "zoom": 8.2,
  "bearing": 0,
  "pitch": 0,
  "glyphs": "https://demotiles.maplibre.org/font/{fontstack}/{range}.pbf",
  "sources": {
    "units": {
      "type": "geojson",
      "data": "../data/units.geojson",
      "attribution": "Representative geological units after USGS SIM 3143"
    }
  },
  "layers": [
    {
      "id": "ocean",
      "type": "background",
      "paint": {
        "background-color": "#a8cbe0"
      }
    },
    {
      "id": "geologic-units",
      "type": "fill",
      "source": "units",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "unit"
          ],
          "Qa",
          "#c5d4fd",
          "Qkh",
          "#00685f",
          "Qksw",
          "#d67b19",
          "Qmlh",
          "#804500",
          "Qhu1801",
          "#007ef2",
          "Qkp",
          "#00c6fc",
          "Qku",
          "#ffac9c",
          "Qhv",
          "#92aaff",
          "Qkhi",
          "#605ca6",
          "Qkk",
          "#89af6a",
          "Qlp",
          "#3fa8b9",
          "Qhm",
          "#8c6542",
          "Qni",
          "#8e8873",
          "Qhw",
          "#8f7055",
          "Qpl",
          "#604637",
          "#cacaca"
        ]
      }
    },
    {
      "id": "unit-contacts",
      "type": "line",
      "source": "units",
      "paint": {
        "line-color": "#434343",
        "line-width": 0.6,
        "line-opacity": 0.55
      }
    },
    {
      "id": "unit-labels",
      "type": "symbol",
      "source": "units",
      "minzoom": 8.5,
      "layout": {
        "text-field": [
          "get",
          "unit"
        ],
        "text-font": [
          "Open Sans Regular",
          "Arial Unicode MS Regular"
        ],
        "text-size": 11,
        "symbol-placement": "point"
      },
      "paint": {
        "text-color": "#3b3b3b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    }
  ]
}
